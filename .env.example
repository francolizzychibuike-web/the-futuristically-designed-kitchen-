# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (must be 3000 in AI Studio preview)
PORT=3000

# JWT_SECRET: Secret key used to sign administrator session tokens
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"

# ADMIN_EMAIL / ADMIN_PASSWORD: Optional initial administrator bootstrap credentials
# If omitted, the first visitor to /admin can create the initial administrator account securely.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# PAYSTACK_SECRET_KEY / PAYSTACK_PUBLIC_KEY: Optional Nigerian Paystack keys
# Can also be configured securely inside the Admin Dashboard > Payment Settings.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
